# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=admin123
DB_NAME=go

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=8004
GIN_MODE=debug  # debug, release

# HTTPS Configuration
USE_HTTPS=false  # Set to "true" to enable HTTPS, "false" for HTTP
# SSL Certificate paths (relative to project root)
CERT_FILE=./certs/cert.pem
KEY_FILE=./certs/key.pem

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Environment: development, production
ENV=development

# Allowed Origins (comma-separated)
# For development: Use "*" to allow all origins
# For production: List specific domains
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://localhost:3001,http://localhost:5173,https://yourdomain.com

# Examples:
# Development: ALLOWED_ORIGINS=*
# Production: ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# ===========================================
# AUTHENTICATION
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=24h

# ===========================================
# MULTI-TENANT (Future)
# ===========================================
# TENANT_MODE=single  # single, multi
# DEFAULT_TENANT_KEY=default

# ===========================================
# FILE UPLOAD
# ===========================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

# ===========================================
# STRIPE (Future)
# ===========================================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ===========================================
# EMAIL (Future)
# ===========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# FROM_EMAIL=noreply@yourdomain.com
# FROM_NAME=Your App Name

# ===========================================
# REDIS (Future - for caching)
# ===========================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ===========================================
# API RATE LIMITING (Future)
# ===========================================
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_DURATION=1m  # 1 minute

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=debug  # debug, info, warn, error
LOG_FILE=./logs/app.log
